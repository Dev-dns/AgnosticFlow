# PostgreSQL
# POSTGRES_DB es la base de datos interna de n8n.
# La base de negocio "agnosticflow" la crea database/init/000_create_agnosticflow.sql
POSTGRES_DB=n8n
POSTGRES_USER=agnosticflow
POSTGRES_PASSWORD=change_me_locally

# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace_with_a_random_secret
# API pública de n8n (la usa n8n/scripts/desplegar_workflow.sh)
# Crear en n8n: Settings > n8n API > Create an API key
N8N_API_KEY=replace_with_n8n_api_key

# Webhook de ingesta (cabecera X-AgnosticFlow-Token)
# Generar con: openssl rand -hex 32
INGESTA_WEBHOOK_TOKEN=replace_with_a_random_token
